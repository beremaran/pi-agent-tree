{
  "name": "@beremaran/pi-agent-tree",
  "version": "0.3.2",
  "description": "Pi extension that enforces task delegation through an on-demand orchestrator with configurable subagent models and agent routing.",
  "type": "module",
  "homepage": "https://github.com/beremaran/pi-agent-tree#readme",
  "bugs": {
    "url": "https://github.com/beremaran/pi-agent-tree/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "orchestrator",
    "subagent",
    "task-delegation"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/pi-agent-tree.git"
  },
  "license": "MIT",
  "funding": {
    "github": "beremaran"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage \"test/*.test.ts\"",
    "test:smoke": "node test/smoke.mjs",
    "lint": "biome check src test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
